rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * GLOBAL ACCESS PROTOCOL
     * For prototyping and shared link stability, we allow public read/write.
     * In production, this should be restricted to authenticated users.
     */
    match /{document=**} {
      allow read, write: if true;
    }

    /**
     * PUBLIC NODES (Explicitly listing all collections for system reliability)
     */
    match /bills/{id} { allow read, write: if true; }
    match /purchases/{id} { allow read, write: if true; }
    match /receipts/{id} { allow read, write: if true; }
    match /challans/{id} { allow read, write: if true; }
    match /pesticide-invoices/{id} { allow read, write: if true; }
    match /statements/{id} { allow read, write: if true; }
    match /fcm-tokens/{id} { allow read, write: if true; }
    match /notificationJobs/{id} { allow read, write: if true; }
    match /parties/{id} { allow read, write: if true; }
    match /products/{id} { allow read, write: if true; }
    match /advances/{id} { allow read, write: if true; }
    match /cold-storage/{id} { allow read, write: if true; }
    match /accessory-ledger/{id} { allow read, write: if true; }
  }
}