/**
 * Core Philosophy:
 * This ruleset establishes a secure-by-default environment for the F.Co Billing System,
 * designed for rapid prototyping. The primary security goal is to allow public read
 * access for specific documents (like invoices, via QR codes) while strictly controlling
 * all write operations. All writes require user authentication. Data that is private
 * to a user (their own profile) is strictly locked down to that user.
 *
 * Data Structure:
 * The data is organized into several top-level collections representing core business
 * entities like products, customers, suppliers, and transactional data like sales and
 * purchase orders. User data is isolated in the `/users/{userId}` collection. Some
 * transactional data, like order items and payments, are stored in subcollections
 * under their parent order document.
 *
 * Key Security Decisions:
 * 1. Public Read for Orders: To support features like QR code scanning for invoices,
 *    individual `get` operations on `sales_orders` and `purchase_orders` are public.
 *    However, `list` operations are disabled to prevent enumeration of all orders.
 * 2. Authenticated Writes: As this is a prototyping phase, all write operations
 *    (create, update, delete) on business collections are permitted for any signed-in
 *    user. This is a temporary measure. For production, these documents MUST be
 *    updated to include an `ownerId` or similar field to lock down writes to specific
 *    users or roles.
 * 3. User Data Privacy: The `/users/{userId}` path is strictly controlled. Users can
 *    only read and write their own document. Listing users is disabled.
 * 4. Relational Integrity: For subcollections, rules ensure that a child document
 *    can only be created if its parent document exists and that the ID fields linking
 *    them are consistent.
 *
 * Denormalization for Authorization:
 * This ruleset is designed with denormalization in mind for future security enhancements.
 * Currently, many collections lack an "owner" field. To move from prototyping to
 * production, you MUST denormalize ownership information (e.g., a `creatorId` or
 * `organizationId` field) onto documents like `sales_orders`, `products`, etc. This
 * will allow for more granular and performant authorization checks without needing
 * costly `get()` calls on related documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns true if the document being operated on already exists.
     * CRITICAL for safe update and delete operations.
     */
    function isExistingDoc() {
      return resource != null;
    }

    /**
     * Returns true if the user is the owner of an existing document.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && isExistingDoc();
    }

    // ------------------------------------------------------------------------
    // User Profile Rules
    // ------------------------------------------------------------------------

    /**
     * @description Users can manage their own profile, but cannot see other profiles.
     * @path        /users/{userId}
     * @allow       (get, update, delete) A logged-in user (`auth.uid: 'user123'`) accesses their own document at `/users/user123`.
     * @allow       (create) A new user (`auth.uid: 'user123'`) creates their own document at `/users/user123`.
     * @deny        (get) A logged-in user (`auth.uid: 'user123'`) tries to read `/users/user456`.
     * @deny        (list) Any user tries to list all documents in the `/users` collection.
     * @principle   Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    // ------------------------------------------------------------------------
    // Public Master Data with Authenticated Writes
    // (Products, Suppliers, Customers, Locations)
    // ------------------------------------------------------------------------

    /**
     * @description Product data is public to read, but only authenticated users can modify it.
     * @path        /products/{productId}
     * @allow       (get, list) Any user, including anonymous users, can read product information.
     * @allow       (create, update, delete) A logged-in user modifies the product catalog.
     * @deny        (create) An anonymous user tries to create a new product.
     * @principle   Enables public browsing of master data while securing modifications.
     */
    match /products/{productId} {
      // CRITICAL: Cannot implement owner-only writes. The 'Product' entity is missing an 'ownerId' or 'authorId' field.
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if isSignedIn() && isExistingDoc(); // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Supplier data is public to read, but only authenticated users can modify it.
     * @path        /suppliers/{supplierId}
     * @allow       (get, list) Any user, including anonymous users, can read supplier information.
     * @allow       (create, update, delete) A logged-in user modifies the supplier list.
     * @deny        (create) An anonymous user tries to create a new supplier.
     * @principle   Enables public browsing of master data while securing modifications.
     */
    match /suppliers/{supplierId} {
      // CRITICAL: Cannot implement owner-only writes. The 'Supplier' entity is missing an 'ownerId' or 'authorId' field.
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if isSignedIn() && isExistingDoc(); // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Customer data is public to read, but only authenticated users can modify it.
     * @path        /customers/{customerId}
     * @allow       (get, list) Any user, including anonymous users, can read customer information.
     * @allow       (create, update, delete) A logged-in user modifies the customer list.
     * @deny        (create) An anonymous user tries to create a new customer.
     * @principle   Enables public browsing of master data while securing modifications.
     */
    match /customers/{customerId} {
      // CRITICAL: Cannot implement owner-only writes. The 'Customer' entity is missing an 'ownerId' or 'authorId' field.
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if isSignedIn() && isExistingDoc(); // TODO: Add owner validation once the schema is updated with an ownership field.
    }
    
    /**
     * @description Location data is public to read, but only authenticated users can modify it.
     * @path        /locations/{locationId}
     * @allow       (get, list) Any user, including anonymous users, can read location information.
     * @allow       (create, update, delete) A logged-in user modifies the location list.
     * @deny        (create) An anonymous user tries to create a new location.
     * @principle   Enables public browsing of master data while securing modifications.
     */
    match /locations/{locationId} {
      // CRITICAL: Cannot implement owner-only writes. The 'Location' entity is missing an 'ownerId' or 'authorId' field.
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if isSignedIn() && isExistingDoc(); // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    // ------------------------------------------------------------------------
    // Transactional Data
    // (Sales Orders & Purchase Orders)
    // ------------------------------------------------------------------------
    match /invoices/{invoiceId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSignedIn();
    }
    /**
     * @description Individual sales orders can be read publicly (e.g., via QR code), but cannot be listed. Writes are restricted to authenticated users.
     * @path        /sales_orders/{salesOrderId}
     * @allow       (get) Any user, including an anonymous one, can fetch a specific sales order.
     * @allow       (create) A signed-in user creates a new sales order.
     * @deny        (list) No user can list all sales orders in the collection.
     * @deny        (update) An anonymous user tries to update a sales order.
     * @principle   Supports direct document access for features like QR scanning while preventing data enumeration.
     */
    match /sales_orders/{salesOrderId} {
      // CRITICAL: Cannot implement owner-only writes. The 'SalesOrder' entity is missing an 'ownerId' or 'customerId' field.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if isSignedIn() && isExistingDoc(); // TODO: Add owner validation once the schema is updated with an ownership field.

      /**
       * @description Order Items are tied to a parent sales order.
       * @path        /sales_orders/{salesOrderId}/order_items/{orderItemId}
       * @allow       (get) Any user can get an order item if the parent order exists.
       * @allow       (create) An authenticated user can add an item to an existing sales order.
       * @deny        (create) A user tries to create an item for a non-existent sales order.
       * @principle   Enforces relational integrity between parent and subcollection documents.
       */
      match /order_items/{orderItemId} {
        allow get: if exists(/databases/$(database)/documents/sales_orders/$(salesOrderId));
        allow list: if false;
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/sales_orders/$(salesOrderId)) && request.resource.data.salesOrderId == salesOrderId;
        allow update, delete: if isSignedIn() && isExistingDoc() && exists(/databases/$(database)/documents/sales_orders/$(salesOrderId));
      }

      /**
       * @description Payments are tied to a parent sales order.
       * @path        /sales_orders/{salesOrderId}/payments/{paymentId}
       * @allow       (get) Any user can get a payment if the parent order exists.
       * @allow       (create) An authenticated user can add a payment to an existing sales order.
       * @deny        (create) A user tries to create a payment for a non-existent sales order.
       * @principle   Enforces relational integrity between parent and subcollection documents.
       */
      match /payments/{paymentId} {
        allow get: if exists(/databases/$(database)/documents/sales_orders/$(salesOrderId));
        allow list: if false;
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/sales_orders/$(salesOrderId)) && request.resource.data.orderId == salesOrderId;
        allow update, delete: if isSignedIn() && isExistingDoc() && exists(/databases/$(database)/documents/sales_orders/$(salesOrderId));
      }
    }

    /**
     * @description Individual purchase orders can be read publicly, but cannot be listed. Writes are restricted to authenticated users.
     * @path        /purchase_orders/{purchaseOrderId}
     * @allow       (get) Any user can fetch a specific purchase order.
     * @allow       (create) A signed-in user creates a new purchase order.
     * @deny        (list) No user can list all purchase orders in the collection.
     * @deny        (update) An anonymous user tries to update a purchase order.
     * @principle   Supports direct document access while preventing data enumeration.
     */
    match /purchase_orders/{purchaseOrderId} {
      // CRITICAL: Cannot implement owner-only writes. The 'PurchaseOrder' entity is missing an 'ownerId' or 'supplierId' field.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if isSignedIn() && isExistingDoc(); // TODO: Add owner validation once the schema is updated with an ownership field.

      /**
       * @description Purchase Order Items are tied to a parent purchase order.
       * @path        /purchase_orders/{purchaseOrderId}/purchase_order_items/{purchaseOrderItemId}
       * @allow       (get) Any user can get a purchase item if the parent order exists.
       * @allow       (create) An authenticated user can add an item to an existing purchase order.
       * @deny        (create) A user tries to create an item for a non-existent purchase order.
       * @principle   Enforces relational integrity between parent and subcollection documents.
       */
      match /purchase_order_items/{purchaseOrderItemId} {
        allow get: if exists(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId));
        allow list: if false;
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId)) && request.resource.data.purchaseOrderId == purchaseOrderId;
        allow update, delete: if isSignedIn() && isExistingDoc() && exists(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId));
      }
    }
  }
}

    