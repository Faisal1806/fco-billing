rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * F.Co GLOBAL ACCESS PROTOCOL (PROTOTYPE)
     * 
     * In this prototyping phase, we allow global recursive read/write access to ensure:
     * 1. Shared links work for unauthenticated customers.
     * 2. Device nodes (FCM) can register for notifications.
     * 3. Cloud Sync works across all terminals without permission blocks.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}