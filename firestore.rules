
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // USER DATA: Users can only read and write their own document.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // PUBLIC BILLS: This collection is for sharing. Anyone can read.
    // This allows QR codes to work for anyone.
    // Writes are still protected.
    match /bills/{billId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    
    // All other business collections are protected.
    // Only authenticated users can write. Read access is public for individual documents
    // to support sharing and QR codes, but listing is disabled.
    match /invoices/{invoiceId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSignedIn();
    }
    match /purchases/{purchaseId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSignedIn();
    }
    match /receipts/{receiptId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSignedIn();
    }
     match /challans/{challanId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isSignedIn();
    }
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /parties/{partyId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /advances/{advanceId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /cold-storage/{csId} {
       allow get, list: if true;
       allow create, update, delete: if isSignedIn();
    }
     match /bikris/{bikriId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /fcm-tokens/{tokenId} {
       allow read, write: if isSignedIn();
    }
    match /notificationJobs/{jobId} {
        allow create: if isSignedIn();
        allow read, update, delete: if false;
    }
  }
}
