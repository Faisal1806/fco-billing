rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * GLOBAL ACCESS PROTOCOL
     * For prototyping and shared link stability, we allow public read/write.
     * In production, this should be restricted to authenticated users.
     */
    match /{document=**} {
      allow read, write: if true;
    }

    /**
     * PUBLIC NODES (Redundant but explicit for clarity)
     */
    match /bills/{id} { allow read, write: if true; }
    match /purchases/{id} { allow read, write: if true; }
    match /receipts/{id} { allow read, write: if true; }
    match /challans/{id} { allow read, write: if true; }
    match /pesticide-invoices/{id} { allow read, write: if true; }
    match /statements/{id} { allow read, write: if true; }
  }
}