rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * F.Co OS GLOBAL ACCESS PROTOCOL
     * 
     * For the prototyping phase and shared link stability, we allow unauthenticated 
     * read/write access to all collections. This ensures that:
     * 1. Shared invoice links can be opened by customers without an account.
     * 2. Device nodes (FCM tokens) can be registered for push notifications.
     * 3. Master Cloud Sync functions correctly across all terminal nodes.
     *
     * In a production environment, this should be restricted to 'request.auth != null'.
     */
    match /{document=**} {
      allow read, write: if true;
    }

    /**
     * SYSTEM NODES (Explicitly ensuring recursive access for critical infrastructure)
     */
    match /fcm-tokens/{document=**} { allow read, write: if true; }
    match /notificationJobs/{document=**} { allow read, write: if true; }
    match /bills/{document=**} { allow read, write: if true; }
    match /purchases/{document=**} { allow read, write: if true; }
    match /receipts/{document=**} { allow read, write: if true; }
    match /challans/{document=**} { allow read, write: if true; }
    match /statements/{document=**} { allow read, write: if true; }
  }
}