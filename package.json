{
  "name": "fco-billing",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "electron:start": "next build && electron .",
    "dist": "next build && electron-builder"
  },
  "build": {
    "appId": "com.fco.billing",
    "productName": "FCO Billing",
    "files": [
      "out/**/*",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fco-apples",
        "repo": "fco-billing"
      }
    ]
  },
  "dependencies": {
    "@genkit-ai/google-genai": "1.21.0",
