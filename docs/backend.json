{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents an application user with defined roles and access.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "FCMToken": {
      "title": "FCM Token",
      "type": "object",
      "description": "Stores Firebase Cloud Messaging tokens for registered device nodes.",
      "properties": {
        "token": { "type": "string" },
        "enabledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "enabledAt"]
    },
    "NotificationJob": {
      "title": "Notification Job",
      "type": "object",
      "description": "A queued job for sending push notifications via Cloud Functions.",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "tokens": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "sent", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "tokens", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/fcm-tokens/{tokenId}",
        "definition": {
          "entityName": "fcmToken",
          "schema": { "$ref": "#/backend/entities/FCMToken" },
          "description": "Stores tokens for push notification delivery to device nodes."
        }
      },
      {
        "path": "/notificationJobs/{jobId}",
        "definition": {
          "entityName": "notificationJob",
          "schema": { "$ref": "#/backend/entities/NotificationJob" },
          "description": "Queue for push notifications to be processed by Cloud Functions."
        }
      }
    ]
  }
}